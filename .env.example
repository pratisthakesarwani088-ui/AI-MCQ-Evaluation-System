# ============================================================
# AI Assistant for MCQ Evaluation System
# Copy this file to ".env" and fill in your own values.
# The application reads these on startup (see backend/app/config.py).
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mcq_evaluation_system

# Required only for AI-Based Evaluation and the AI Assistant panel.
# OMR Evaluation works fully offline without this.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_API_KEY
GEMINI_MODEL=gemini-3.6-flash
